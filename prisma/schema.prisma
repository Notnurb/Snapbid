generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  free
  pro
  crew
}

enum QuoteStatus {
  draft
  sent
  viewed
  accepted
  declined
  expired
}

enum PaymentType {
  deposit
  balance
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum FollowupStatus {
  scheduled
  sent
  canceled
}

model User {
  id                String   @id @default(cuid())
  clerkId           String   @unique @map("clerk_id")
  email             String   @unique
  name              String?
  businessName      String?  @map("business_name")
  logoUrl           String?  @map("logo_url")
  brandColor        String   @default("#16a34a") @map("brand_color")
  replyToEmail      String?  @map("reply_to_email")
  phone             String?
  plan              Plan     @default(free)
  stripeCustomerId  String?  @unique @map("stripe_customer_id")
  stripeAccountId   String?  @map("stripe_account_id")
  defaultDepositPct Int      @default(25) @map("default_deposit_pct")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  priceBooks PriceBook[]
  quotes     Quote[]
  events     Event[]

  @@map("users")
}

model PriceBook {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String   @default("Default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PriceItem[]

  @@index([userId])
  @@map("price_books")
}

model PriceItem {
  id             String   @id @default(cuid())
  priceBookId    String   @map("price_book_id")
  name           String
  unit           String   @default("each")
  unitPriceCents Int      @map("unit_price_cents")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  priceBook  PriceBook   @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  quoteItems QuoteItem[]

  @@index([priceBookId])
  @@map("price_items")
}

model Quote {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  publicToken   String      @unique @default(cuid()) @map("public_token")
  status        QuoteStatus @default(draft)
  title         String?
  clientName    String?     @map("client_name")
  clientEmail   String?     @map("client_email")
  clientPhone   String?     @map("client_phone")
  description   String?
  scopeSummary  String?     @map("scope_summary")
  photos        Json        @default("[]")
  riskFlags     Json        @default("[]") @map("risk_flags")
  notes         String?
  depositPct    Int         @default(25) @map("deposit_pct")
  subtotalCents Int         @default(0) @map("subtotal_cents")
  taxRateBps    Int         @default(0) @map("tax_rate_bps")
  totalCents    Int         @default(0) @map("total_cents")
  sentAt        DateTime?   @map("sent_at")
  viewedAt      DateTime?   @map("viewed_at")
  acceptedAt    DateTime?   @map("accepted_at")
  declinedAt    DateTime?   @map("declined_at")
  expiresAt     DateTime?   @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     QuoteItem[]
  payments  Payment[]
  followups Followup[]
  events    Event[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("quotes")
}

model QuoteItem {
  id             String   @id @default(cuid())
  quoteId        String   @map("quote_id")
  priceItemId    String?  @map("price_item_id")
  description    String
  qty            Float    @default(1)
  unit           String   @default("each")
  unitPriceCents Int?     @map("unit_price_cents")
  lineTotalCents Int      @default(0) @map("line_total_cents")
  confidence     Float?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  quote     Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  priceItem PriceItem? @relation(fields: [priceItemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_items")
}

model Payment {
  id                      String        @id @default(cuid())
  quoteId                 String        @map("quote_id")
  type                    PaymentType
  status                  PaymentStatus @default(pending)
  amountCents             Int           @map("amount_cents")
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id")
  paidAt                  DateTime?     @map("paid_at")
  createdAt               DateTime      @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("payments")
}

model Followup {
  id        String         @id @default(cuid())
  quoteId   String         @map("quote_id")
  kind      String // "24h" | "72h"
  dueAt     DateTime       @map("due_at")
  status    FollowupStatus @default(scheduled)
  sentAt    DateTime?      @map("sent_at")
  createdAt DateTime       @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@map("followups")
}

model Event {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  quoteId   String?  @map("quote_id")
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([userId, type])
  @@map("events")
}
